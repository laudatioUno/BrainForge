# Keine Verzeichnisauflistung
Options -Indexes

# Datenbank-Dateien nie ausliefern
<FilesMatch "\.(sqlite|sqlite3|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

DirectoryIndex index.php

# Kurze Adresse für den Admin-Bereich: /admin (oder /admin/) leitet auf admin.php weiter
<IfModule mod_rewrite.c>
    RewriteEngine On
    # %1 = Pfad bis zum Programmordner, so klappt es auch in einem Unterordner (z. B. /quiz/admin)
    RewriteCond %{REQUEST_URI} ^(.*/)admin/?$
    RewriteRule ^admin/?$ %1admin.php [R=302,L]
</IfModule>
